# Copia estas variables en Render > Environment.
# NO escribas claves reales en este archivo ni en GitHub.

FAL_KEY=
APP_SIGNING_SECRET=

# Puerto local. Render añade PORT automáticamente.
PORT=3000

# Opcional: limita el tamaño de cada archivo subido (bytes).
MAX_UPLOAD_BYTES=12582912

# Opcional: configura tarifas orientativas desde Render.
# El formato es JSON y los valores representan USD por segundo.
# Ejemplo: {"seedance":0.10,"kling":0.07}
# No añadas valores sin comprobar primero la tarifa actual del proveedor.
MODEL_PRICE_USD_PER_SECOND={}
